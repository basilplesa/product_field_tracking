<odoo>
  <record id="view_product_field_tracking_settings" model="ir.ui.view">
    <field name="name">product.field.tracking.settings</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@id='languages']" position="after">
        <div class="app_settings_block mt32" data-string="Configuración de seguimiento de campos de producto">
          <h2 class="mt16">Configuración de seguimiento de campos de producto</h2>
          <div class="row mt16 o_settings_container">
          <p class="text-muted">
            Activa o desactiva los campos a los que se requiere registrar la edición/cambio en el formulario de producto.
          </p>
            <div class="col-12 col-lg-6">
              <div class="form-check mb-2">
                <field name="track_name"/>
                <label for="track_name">Nombre del producto</label>
              </div>
              <div class="form-check mb-2">
                <field name="track_default_code"/>
                <label for="track_default_code">Referencia interna</label>
              </div>
              <div class="form-check mb-2">
                <field name="track_list_price"/>
                <label for="track_list_price">Precio de venta</label>
              </div>
              <div class="form-check mb-2">
                <field name="track_standard_price"/>
                <label for="track_standard_price">Costo</label>
              </div>
              <div class="form-check mb-2">
                <field name="track_barcode"/>
                <label for="track_barcode">Código de barras</label>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>